# =============================================================================
# RAG System example configuration (12-factor).
# Copy to `.env` and adjust. EVERY value below has a safe default in code, so an
# empty .env still runs the fully offline, zero-dependency default stack.
# Secrets (API keys) are read from the conventional, UN-prefixed names.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
RAG_ENV=local                       # local | prod  (prod hides the /docs and /redoc UIs)
RAG_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
RAG_LOG_JSON=true                   # true => structured JSON logs; false => pretty console
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_CORS_ORIGINS=*                  # comma-separated origins, or * for any

# --- Security & limits ------------------------------------------------------
RAG_API_KEY=                        # if set, requests must send `X-API-Key: <value>`
RAG_MAX_QUESTION_CHARS=4000         # reject longer questions (input validation)
RAG_MAX_DOCUMENT_CHARS=200000       # reject larger single documents on ingest
RAG_REQUEST_TIMEOUT_S=30            # server-side cap on a single query
RAG_RATE_LIMIT=60/minute            # slowapi rate limit per client IP (empty disables)

# --- Provider selection (switch the whole stack by config only) -------------
RAG_EMBEDDING_PROVIDER=fake         # fake | local | openai
RAG_LLM_PROVIDER=extractive         # extractive | ollama | openai | anthropic
RAG_VECTOR_STORE=faiss              # faiss | chroma | qdrant

# --- Chunking & retrieval ---------------------------------------------------
RAG_TOKENIZER_ENCODING=cl100k_base  # tiktoken encoding used for token-aware chunking
RAG_CHUNK_SIZE=400                  # max tokens per chunk
RAG_CHUNK_OVERLAP=80                # token overlap between consecutive chunks
RAG_TOP_K=4                         # number of chunks retrieved per query
RAG_EMBEDDING_DIM=384               # vector dimension (fake embedder & store init)

# --- Embeddings: local (sentence-transformers) ------------------------------
RAG_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# alternative: BAAI/bge-small-en-v1.5

# --- Embeddings: OpenAI -----------------------------------------------------
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=                     # required only when a provider is set to `openai`
OPENAI_BASE_URL=                    # optional override (Azure / proxy / compatible servers)

# --- LLM: generation knobs (apply to all chat providers) --------------------
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=512
RAG_SYSTEM_PROMPT=                  # optional override of the grounded system prompt

# --- LLM: OpenAI ------------------------------------------------------------
RAG_OPENAI_LLM_MODEL=gpt-4o-mini

# --- LLM: Anthropic ---------------------------------------------------------
RAG_ANTHROPIC_LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=                  # required only when RAG_LLM_PROVIDER=anthropic

# --- LLM/embeddings: Ollama (local) -----------------------------------------
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_LLM_MODEL=llama3.2

# --- Vector store: paths / connection ---------------------------------------
RAG_COLLECTION_NAME=rag_documents
RAG_FAISS_PATH=./.data/faiss        # on-disk persistence for the FAISS index
RAG_CHROMA_PATH=./.data/chroma
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=

# --- Caching ----------------------------------------------------------------
RAG_EMBEDDING_CACHE=memory          # none | memory | disk
RAG_EMBEDDING_CACHE_PATH=./.data/embcache
RAG_EMBEDDING_CACHE_SIZE=10000      # max entries (memory) before LRU eviction
RAG_RESPONSE_CACHE=none             # none | memory
RAG_RESPONSE_CACHE_TTL_S=300

# --- Resilience -------------------------------------------------------------
RAG_PROVIDER_MAX_RETRIES=3          # tenacity attempts on remote provider calls
RAG_PROVIDER_BACKOFF_S=0.5          # exponential backoff base (seconds)
RAG_FALLBACK_TO_OFFLINE=true        # degrade to fake/extractive if a real provider fails

# --- Observability ----------------------------------------------------------
RAG_METRICS_ENABLED=true            # expose Prometheus /metrics
OTEL_ENABLED=false                  # enable OpenTelemetry tracing (needs the `otel` extra)
OTEL_SERVICE_NAME=rag-system
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Corpus / data ----------------------------------------------------------
RAG_CORPUS_DIR=./data/corpus        # sample corpus ingested by `POST /api/v1/ingest`

# --- UI (Streamlit) ---------------------------------------------------------
RAG_API_URL=http://localhost:8000   # base URL the Streamlit UI calls
RAG_UI_PORT=8501
